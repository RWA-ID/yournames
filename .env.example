# ── yournames.eth secrets (gitignored) ───────────────────────────────────────
# Reown (WalletConnect) — canonical shared project ID for all dapps
NEXT_PUBLIC_REOWN_PROJECT_ID=43bdd1b8c477ac4d4a4264a14a8472f8

# Alchemy — used for mainnet RPC + NFT API (avatar picker / owned-names fallback).
# App works without it (public RPC fallback), but the NFT picker needs it.
NEXT_PUBLIC_ALCHEMY_API_KEY=

# Etherscan — optional, used for richer stats; links work without it.
NEXT_PUBLIC_ETHERSCAN_API_KEY=

# Google Search Console verification token (content="..." value only)
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# ENS subgraph override (defaults to the public hosted endpoint)
NEXT_PUBLIC_ENS_SUBGRAPH_URL=

# Pinata JWT — only needed by pin.sh at deploy time (NOT a NEXT_PUBLIC var)
PINATA_JWT=
